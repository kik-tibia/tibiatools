---
const { title = "TibiaTools" } = Astro.props;
import "../styles/global.css";
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <h1>TibiaTools</h1>
      <nav>
        <a href="/" class={Astro.url.pathname === "/" ? "active" : ""}>Home</a>
        <a href="/tools/info" class={Astro.url.pathname.startsWith("/tools/info") ? "active" : ""}>Info</a>
        <a href="/tools/calculator" class={Astro.url.pathname.startsWith("/tools/calculator") ? "active" : ""}>Calculator</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
