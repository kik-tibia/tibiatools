---
import "@styles/global.css";
const { title = "Tibia Tools" } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <title>{title}</title>
    <script is:inline>
      (function() {
        var pref = localStorage.getItem("theme");
        var effective = pref || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        document.documentElement.setAttribute("data-theme", effective);
      })();
    </script>
  </head>
  <body>
    <header>
      <div>
        <h1>Tibia Tools – {title}</h1>
        <nav>
          <a href="/" class={Astro.url.pathname === "/" ? "active" : ""}>Home</a>
          <a href="/tools/info" class={Astro.url.pathname.startsWith("/tools/info") ? "active" : ""}>Info</a>
          <a href="/tools/calculator" class={Astro.url.pathname.startsWith("/tools/calculator") ? "active" : ""}>Calculator</a>
        </nav>
      </div>
      <div id="theme-toggle">
        <button id="theme-btn" aria-label="Change theme" aria-expanded="false">
          <img src="/sun.svg" alt="" width="18" height="18" />
          <img src="/moon.svg" alt="" width="18" height="18" />
        </button>
        <div id="theme-menu" role="menu">
          <button data-theme-value="" role="menuitem">
            <img src="/monitor.svg" alt="" width="16" height="16" /> System
          </button>
          <button data-theme-value="light" role="menuitem">
            <img src="/sun.svg" alt="" width="16" height="16" /> Light
          </button>
          <button data-theme-value="dark" role="menuitem">
            <img src="/moon.svg" alt="" width="16" height="16" /> Dark
          </button>
        </div>
      </div>
      <script is:inline>
        (function() {
          var btn = document.getElementById("theme-btn");
          var btnIcons = btn.querySelectorAll("img");
          var menu = document.getElementById("theme-menu");
          var items = menu.querySelectorAll("button");
          var mq = matchMedia("(prefers-color-scheme: light)");

          function applyActive(value) {
            items.forEach(function(b) {
              b.classList.toggle("active", b.getAttribute("data-theme-value") === value);
            });
          }

          function apply() {
            var p = localStorage.getItem("theme") || "";
            var effective = p || (mq.matches ? "light" : "dark");
            document.documentElement.setAttribute("data-theme", effective);
            applyActive(p);
            btnIcons[0].style.display = effective === "light" ? "" : "none";
            btnIcons[1].style.display = effective === "dark" ? "" : "none";
          }

          function toggle() {
            var open = menu.classList.toggle("open");
            btn.setAttribute("aria-expanded", open);
          }

          function close() {
            menu.classList.remove("open");
            btn.setAttribute("aria-expanded", "false");
          }

          apply();

          btn.addEventListener("click", function(e) {
            e.stopPropagation();
            toggle();
          });

          items.forEach(function(b) {
            b.addEventListener("click", function() {
              var v = b.getAttribute("data-theme-value");
              if (v) {
                localStorage.setItem("theme", v);
              } else {
                localStorage.removeItem("theme");
              }
              apply();
              close();
            });
          });

          document.addEventListener("click", function(e) {
            if (!menu.contains(e.target) && e.target !== btn) {
              close();
            }
          });

          mq.addEventListener("change", apply);
        })();
      </script>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; 2025&ndash;{new Date().getFullYear()} TibiaTools.io</p>
      <p>
        <a href="https://www.tibia.com" target="_blank" rel="noopener">Tibia</a> is a registered trademark of
        <a href="https://www.cipsoft.com" target="_blank" rel="noopener">CipSoft GmbH</a>.
        All game content and materials are the property of <a href="https://www.cipsoft.com" target="_blank" rel="noopener">CipSoft GmbH</a>.
      </p>
      <p>
        <a href="https://discord.com/users/tom50" target="_blank" rel="noopener" class="discord-link">
          <img src="/discord.svg" alt="Discord" width="20" height="20" />
        </a>
      </p>
    </footer>
  </body>
</html>
